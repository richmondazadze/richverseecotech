# Copy to .env and fill in. Required for the contact + newsletter forms (Vercel serverless).
# Get a key at https://resend.com  → API Keys
RESEND_API_KEY=

# Optional overrides:
# Where form notifications are delivered
CONTACT_TO=richverseecotech@gmail.com
# Verified sender (must be a domain verified in Resend)
CONTACT_FROM=Richverseecotech <contact@richverseecotech.com>
