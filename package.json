{
  "name": "richverse-redesign",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node prerender.js",
    "build:spa": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "node --test scripts/forms.test.mjs scripts/packaged-forms.test.mjs",
    "verify": "npm run typecheck && npm test && npm run build && node scripts/verify-site.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@gsap/react": "2.1.2",
    "gsap": "3.15.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^5.7.0",
    "react-router-dom": "^6.26.2",
    "resend": "^4.8.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^5.8.23",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.14"
  }
}
